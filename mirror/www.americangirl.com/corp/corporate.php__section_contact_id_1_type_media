	message = message + "<br><b>City: </b>" + document.contact_us.City.value;
	message = message + "<br><b>State: </b>" + document.contact_us.State.value;
	message = message + "<br><b>Zip: </b>" + document.contact_us.Zip.value;
	message = message + "<br><b>Publication: </b>" + document.contact_us.Publication.value;
	message = message + "<br><b>Additional Information: </b>" + document.contact_us.OtherInfo.value;
	
	document.contact_us.MSGCONTENT.value=message;
	
    document.contact_us.submit();
    return true;
}
