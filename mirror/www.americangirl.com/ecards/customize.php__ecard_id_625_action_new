function sendDateValidator(ecardFrm){

	var curDate = new Date(ecardFrm.cur_year.value, ecardFrm.cur_month.value-1, ecardFrm.cur_day.value,12,00,00);
		
	var sendDate = new Date (ecardFrm.year[ecardFrm.year.selectedIndex].value, 
					ecardFrm.month[ecardFrm.month.selectedIndex].value-1,
					ecardFrm.day[ecardFrm.day.selectedIndex].value,12,00,00);
	
	
			
	/*alert (" yr="+ ecardFrm.year[ecardFrm.year.selectedIndex].value + 
			" mon= " + ecardFrm.month[ecardFrm.month.selectedIndex].value + 
			" day= " + ecardFrm.day[ecardFrm.day.selectedIndex].value);
	*/		
	if(sendDate < curDate){
	
		alert("Requested send date is in the past");
		return false;
	} 
	
    return true; 


}
function isEmailAddr(email)
{
  var result = false
  var theStr = new String(email)
  var index = theStr.indexOf("@");
  if (index > 0)
  {
    var pindex = theStr.indexOf(".",index);
    if ((pindex > index+1) && (theStr.length > pindex+1))
	result = true;
  }
  return result;
}

function EmailValidator(email_addr, fieldName)
{

  if (email_addr.value == "")
  {
    alert("Please enter a value for the \"" + fieldName +"\" field.");
   // theForm.email.focus();
    return (false);
  }

  if (!isEmailAddr(email_addr.value))
  {
    alert("Please enter a complete email address in the  \"" + fieldName +"\" field.");
//    theForm.email.focus();
    return (false);
  }
   
  if (email_addr.value.length < 3)
  {
    alert("Please enter at least 3 characters in the \"" + fieldName +"\" field.");
   // theForm.email.focus();
    return (false);
  }
  return (true);
}

 function  previewValidation() {
 
 
 if(document.ecard.message.value.length < 1) {
 	alert("Please enter a message.");
	document.ecard.message.focus();
	return false;
	}
	var maxMsgWidth=350;
 if(document.ecard.message.value.length >= maxMsgWidth) {
 	alert("Your message exceeds " + maxMsgWidth + " characters." );
	document.ecard.message.focus();
	return false;
	}

 return true;
 }

function submitValidation(){
 if(! EmailValidator(document.ecard.sender_email, "Your Email Address") ){
 document.ecard.sender_email.focus();
 return false;
 }
  if(! EmailValidator(document.ecard.recipient_email, "Recipient Email Address") ){
 document.ecard.recipient_email.focus();
 return false;
 }
 if(!sendDateValidator(document.ecard)){
 	document.ecard.month.focus();
 	return false;
 	}
 
 if(! previewValidation() )
 	return false;
 
 
 return true;

}
//set the action url to either preview.php or submit.php
