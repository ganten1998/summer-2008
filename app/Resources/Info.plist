<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleName</key>
	<string>Summer 2008</string>
	<key>CFBundleDisplayName</key>
	<string>Summer 2008 — An American Girl Archive</string>
	<key>CFBundleExecutable</key>
	<string>AGDLauncher</string>
	<key>CFBundleIdentifier</key>
	<string>org.coconut.summer2008</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>LSMinimumSystemVersion</key>
	<string>11.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSSupportsAutomaticGraphicsSwitching</key>
	<true/>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.entertainment</string>
	<!-- Allow loading our custom agd:// scheme and outbound Wayback fetches -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<!-- Register agd:// with Launch Services so e-card pickup links in a
	     recipient's email open the app directly on their card — the 2026
	     equivalent of clicking the 2008 "view your greeting" email link.

	     NOTE: this is macOS-only. The Windows installer does NOT yet register
	     the scheme (no [Registry] section in installer.iss) and App.xaml.cs
	     ignores argv, so a pickup link does nothing on Windows. Known gap;
	     do not describe the scheme as cross-platform until both halves land. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>Summer 2008 Archive Page</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>agd</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
