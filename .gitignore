# macOS noise
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*

# Build outputs (regenerated by app/build.sh and app/make-dmg.sh).
# We DO keep build/cdx/ — those JSONs are inputs to the downloader, not
# outputs, and re-running the Wayback CDX query is slow + flaky.
build/*
!build/cdx/
*.app/
*.dmg
*.zip

# Wine + Director + Flash projectors (~625 MB of Adobe IP). Populated
# locally via tools/fetch-projector.sh — never committed.
projector/Wine/
projector/Shockwave/
projector/Flash/

# Windows projectors (186 MB of Adobe IP, hydrated from the build-deps-v1
# GitHub Release on this repo). Never committed; tools/fetch-projector-windows.ps1
# downloads them at build time.
projector-windows/Flash/
projector-windows/Shockwave/

# .NET / WPF build outputs from the Windows port
app-windows/bin/
app-windows/obj/
app-windows/build/

# Patcher backup (regenerable from mirror/ by running the patcher).
mirror_unpatched/

# Curated games staging dir (Flashpoint-sourced repairs, populated locally).
games/

# Editor / IDE
.idea/
.vscode/
*.swp
*~

# Temporary files our tools may produce
*.tmp
/tmp/
.cache/

# Logs — regenerable; not part of the source.
*.log
