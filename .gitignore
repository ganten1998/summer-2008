# macOS noise
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*

# Build outputs (regenerated by app/build.sh and app/make-dmg.sh).
# We DO keep build/cdx/ — those JSONs are inputs to the downloader, not
# outputs, and re-running the Wayback CDX query is slow + flaky.
build/*
!build/cdx/
*.app/
*.dmg
*.zip

# Wine + Director projectors (610 MB of Adobe IP). Populated locally via
# tools/fetch-projector.sh — never committed.
projector/Wine/
projector/Shockwave/
# We DO commit projector/Flash Player.app + the original DMG since they're
# tiny and stable, but if you'd rather fetch those too, add:
# projector/Flash Player.app/
# projector/flashplayer_32_sa.dmg

# Patcher backup (regenerable from mirror/ by running the patcher).
mirror_unpatched/

# Curated games staging dir (Flashpoint-sourced repairs, populated locally).
games/

# Editor / IDE
.idea/
.vscode/
*.swp
*~

# Temporary files our tools may produce
*.tmp
/tmp/
.cache/

# Logs — regenerable; not part of the source.
*.log
